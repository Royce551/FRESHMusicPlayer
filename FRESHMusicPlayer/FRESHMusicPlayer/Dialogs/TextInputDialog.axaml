<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Width="400" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        TransparencyLevelHint="Transparent" ShowInTaskbar="False" WindowDecorations="None"
        x:Class="FRESHMusicPlayer.TextInputDialog">
    <Border Padding="10" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource PrimaryTextColor}" Background="{DynamicResource ForegroundColor}">
		<StackPanel>
			<TextBlock x:Name="PromptTextBlock"/>
            <TextBox x:Name="InputTextBox"/>

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
				<Button Content="OK" HorizontalAlignment="Right" HotKey="Enter" Click="Button_Click"/>
                <Button Content="Cancel" HorizontalAlignment="Right" HotKey="Enter" Click="Button_Click_1"/>
            </StackPanel>
            
        </StackPanel>
    </Border>
</Window>
