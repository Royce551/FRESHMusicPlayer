<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Grid.TrackRow > StackPanel > Button">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector="Grid.TrackRow:pointerover > StackPanel > Button[Tag=true], ListBoxItem:focus-within > Grid.TrackRow > StackPanel > Button[Tag=true]">
    <Setter Property="IsVisible" Value="True"/>
  </Style>

  <Style Selector=".HeaderRow .RowActions > Button, .ActionRow .RowActions > Button">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector=".HeaderRow:pointerover .RowActions > Button, ListBoxItem:focus-within > .HeaderRow .RowActions > Button, .ActionRow:pointerover .RowActions > Button, ListBoxItem:focus-within > .ActionRow .RowActions > Button">
    <Setter Property="IsVisible" Value="True"/>
  </Style>
</Styles>
