<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:resx="using:FRESHMusicPlayer.Properties"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:FRESHMusicPlayer.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FRESHMusicPlayer.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450" x:DataType="vm:SearchViewModel" Loaded="UserControl_Loaded"
             x:Class="FRESHMusicPlayer.Views.SearchView" Background="{DynamicResource SecondaryColor}">
    <DockPanel>
		<TextBox x:Name="SearchBox" DockPanel.Dock="Top" PlaceholderText="{x:Static resx:Resources.SEARCH_PLACEHOLDER}" Text="{Binding Search}" Margin="10,5,10,0" KeyDown="SearchBox_KeyDown"/>
        <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
            <TextBlock Text="{Binding FooterText}" FontSize="12" Foreground="{DynamicResource SecondaryTextColor}" Margin="10,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <Button Content="{x:Static resx:Resources.CONTROLS_PLAYALL}" Command="{Binding PlayAll}" DockPanel.Dock="Right" Margin="0,10,10,10"/>
          <Button Content="{x:Static resx:Resources.CONTROLS_ENQUEUEALL}" Command="{Binding EnqueueAll}" DockPanel.Dock="Right" Margin="0,10,10,10"/>
        </DockPanel>

      <ListBox x:Name="MainListBox" ItemsSource="{Binding Tracks^}" BorderBrush="Transparent" IsTextSearchEnabled="True" SelectionMode="Single,Toggle" KeyboardNavigation.TabNavigation="Continue" Margin="10,5">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel/>
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate DataType="vm:DatabaseTrackViewModel">
          <Grid RowDefinitions="*,*" ColumnDefinitions="*,Auto" Background="Transparent">
            <Grid.Styles>
              <Style Selector="Grid > StackPanel > Button">
					<Setter Property="IsVisible" Value="False"/>
				</Style>
				<Style Selector="Grid:pointerover > StackPanel > Button[Tag=true]">
					<Setter Property="IsVisible" Value="True"/>
				</Style>

				<Style Selector="Grid:pointerover > Grid > StackPanel > Button[Tag=false]">
					<Setter Property="IsVisible" Value="False"/>
				</Style>
				<Style Selector="ListBoxItem:focus-within > Grid > StackPanel > Button[Tag=true]">
					<Setter Property="IsVisible" Value="True"/>
				</Style>
	
				<Style Selector="ListBoxItem:focus-within > Grid > StackPanel > Button[Tag=false]">
					<Setter Property="IsVisible" Value="False"/>
				</Style>
            </Grid.Styles>
            
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Title}" FontSize="12" Opacity="{Binding Opacity}"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding ArtistAlbumLabel}" FontSize="9" Foreground="{DynamicResource SecondaryTextColor}" Opacity="{Binding Opacity}"/>
            <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                <Button Content="{x:Static resx:Resources.CONTROLS_GOTOARTIST}" Command="{Binding GoToArtist}" IsTabStop="True" Tag="{Binding ViewModel.MainView.IsShiftHeld}"/>
			    <Button Content="{x:Static resx:Resources.CONTROLS_GOTOALBUM}" Command="{Binding GoToAlbum}" IsTabStop="True" Tag="{Binding ViewModel.MainView.IsShiftHeld}"/>
                <Button Content="{x:Static resx:Resources.CONTROLS_ENQUEUE}" Command="{Binding Enqueue}" IsTabStop="True" Tag="{x:True}"/>
                <Button Content="{x:Static resx:Resources.CONTROLS_PLAY}" Command="{Binding Play}" IsTabStop="True" Tag="{x:True}"/>          
            </StackPanel>
            <Grid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{x:Static resx:Resources.CONTROLS_PLAY}" Command="{Binding Play}"/>
                <MenuItem Header="{x:Static resx:Resources.CONTROLS_ENQUEUE}" Command="{Binding Enqueue}"/>
                <MenuItem Header="{x:Static resx:Resources.CONTROLS_PLAYNEXT}" Command="{Binding PlayNext}"/>
                <Separator/>
                <MenuItem Header="{x:Static resx:Resources.CONTROLS_GOTO}">
                  <MenuItem Header="{x:Static resx:Resources.CONTROLS_ARTIST}" Command="{Binding GoToArtist}"/>
                  <MenuItem Header="{x:Static resx:Resources.CONTROLS_ALBUM}" Command="{Binding GoToAlbum}"/>
                </MenuItem>
                <MenuItem Header="{x:Static resx:Resources.PLAYLISTMANAGEMENT}" Command="{Binding PlaylistManagement}"/>
                <MenuItem Header="{x:Static resx:Resources.LIBRARY_REMOVE}" Command="{Binding RemoveFromLibrary}"/>
                <MenuItem Header="{x:Static resx:Resources.CONTROLS_OPEN_FILEEXPLORER}" Command="{Binding OpenInFileExplorer}"/>
              </ContextMenu>
            </Grid.ContextMenu>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    </DockPanel>
</UserControl>
